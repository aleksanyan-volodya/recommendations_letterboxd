# Copy to .env and fill in. .env is gitignored.

# TMDb API read access token (v4 "Bearer" token) OR the v3 API key.
# Get one at https://www.themoviedb.org/settings/api (free, instant).
# Prefer the v4 token; if you only have the v3 key, set LBREC_TMDB_API_KEY instead.
LBREC_TMDB_TOKEN=

# Optional: v3 API key fallback.
# LBREC_TMDB_API_KEY=

# Optional overrides.
# LBREC_EXPORT_DIR=Data
# LBREC_ARTIFACTS_DIR=artifacts
# LBREC_TMDB_RPS=20
